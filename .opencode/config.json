{
  "$schema": "https://opencode.ai/config.json",
  "model": "azure/gpt-5.4-1",
  "provider": {
    "azure": {
      "npm": "@ai-sdk/openai",
      "name": "AIPilot AI",
      "options": {
        "baseURL": "https://nextgen.azure-api.net/api/openai/v1",
        "apiKey": "57127f94ec574fc98070d488df2dc2a4"
      },
      "models": {
        "gpt-5.4-1": {
          "id": "gpt-5.4-1",
          "name": "GPT-5.4 stable (AIPilot)",
          "options": {
            "reasoningEffort": "high"
          }
        },
        "gpt-5.5-1": {
          "id": "gpt-5.5-1",
          "name": "GPT-5.5 premium (AIPilot)",
          "options": {
            "reasoningEffort": "high"
          }
        },
        "gpt-5.3-codex": {
          "id": "gpt-5.3-codex",
          "name": "GPT-5.3 Codex (AIPilot)",
          "options": {
            "reasoningEffort": "high"
          }
        },
        "gpt-5.4-2": {
          "id": "gpt-5.4-2",
          "name": "GPT-5.4 secondary (AIPilot)",
          "options": {
            "reasoningEffort": "high"
          }
        },
        "gpt-5.4-pro": {
          "id": "gpt-5.4-pro",
          "name": "GPT-5.4 Pro (AIPilot)",
          "options": {
            "reasoningEffort": "high"
          }
        }
      },
      "env": [
        "AIPILOT_OPENAI_BASE_URL",
        "AZURE_OPENAI_API_KEY"
      ]
    }
  }
}
